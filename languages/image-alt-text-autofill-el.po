#: includes/class-tet-alt-admin.php:45 includes/class-tet-alt-admin.php:97
msgid "Settings"
msgstr "Ρυθμίσεις"

#: includes/class-tet-alt-admin.php:52
msgid "Alt Text"
msgstr "Εναλλακτικό κείμενο"

#. translators: 1: images done, 2: images in total.
#: includes/class-tet-alt-admin.php:69
msgid "%1$d of %2$d images"
msgstr "%1$d από %2$d εικόνες"

#. translators: 1: images done, 2: images in total.
#: includes/class-tet-alt-admin.php:70
msgid "No images match. Nothing to do."
msgstr "Καμία εικόνα δεν ταιριάζει. Δεν υπάρχει κάτι να γίνει."

#. translators: 1: images done, 2: images in total.
#: includes/class-tet-alt-admin.php:71
msgid "Finished."
msgstr "Ολοκληρώθηκε."

#: includes/class-tet-alt-admin.php:72
msgid "Stopped."
msgstr "Διακόπηκε."

#: includes/class-tet-alt-admin.php:73
msgid "The request failed. Check your connection and try again."
msgstr "Το αίτημα απέτυχε. Ελέγξτε τη σύνδεση και δοκιμάστε ξανά."

#: includes/class-tet-alt-admin.php:74
msgid "Saved"
msgstr "Αποθηκεύτηκε"

#: includes/class-tet-alt-admin.php:75 includes/class-tet-alt-admin.php:170
msgid "Preview"
msgstr "Προεπισκόπηση"

#: includes/class-tet-alt-admin.php:76
msgid "Kept"
msgstr "Διατηρήθηκε"

#: includes/class-tet-alt-admin.php:77
msgid "Error"
msgstr "Σφάλμα"

#: includes/class-tet-alt-admin.php:78 includes/class-tet-alt-admin.php:149 includes/class-tet-alt-media.php:168 includes/class-tet-alt-settings.php:161
msgid "AI"
msgstr "AI"

#: includes/class-tet-alt-admin.php:79 includes/class-tet-alt-admin.php:148 includes/class-tet-alt-settings.php:138
msgid "Template"
msgstr "Πρότυπο"

#. translators: %d: number of images.
#: includes/class-tet-alt-admin.php:81
msgid "Images to send to your AI provider: %d (one paid request each). Continue?"
msgstr "Εικόνες που θα σταλούν στον πάροχο AI: %d (ένα χρεώσιμο αίτημα η καθεμία). Συνέχεια;"

#. translators: %d: number of images.
#: includes/class-tet-alt-admin.php:82
msgid "This replaces every alt text, including ones written by people. Continue?"
msgstr "Θα αντικατασταθούν όλα τα alt, και όσα έγραψαν άνθρωποι. Συνέχεια;"

#: includes/class-tet-alt-admin.php:96
msgid "Bulk generate"
msgstr "Μαζική δημιουργία"

#: includes/class-tet-alt-admin.php:127
msgid "Images"
msgstr "Εικόνες"

#: includes/class-tet-alt-admin.php:128
msgid "Without alt text"
msgstr "Χωρίς alt"

#: includes/class-tet-alt-admin.php:129
msgid "Automatic (template)"
msgstr "Αυτόματα (πρότυπο)"

#: includes/class-tet-alt-admin.php:130
msgid "Written by AI"
msgstr "Από AI"

#. translators: %s: number of images.
#: includes/class-tet-alt-admin.php:141
msgid "Use all images instead"
msgstr "Χρήση όλων των εικόνων"

#: includes/class-tet-alt-admin.php:146
msgid "Write with"
msgstr "Δημιουργία με"

#: includes/class-tet-alt-admin.php:151 includes/class-tet-alt-settings.php:133
msgid "AI can cost money."
msgstr "Το AI μπορεί να έχει χρεώσεις."

#: includes/class-tet-alt-admin.php:154
msgid "Why is AI not available?"
msgstr "Γιατί δεν είναι διαθέσιμο το AI;"

#: includes/class-tet-alt-admin.php:159
msgid "Which images"
msgstr "Ποιες εικόνες"

#: includes/class-tet-alt-admin.php:162
msgid "Only those without alt text"
msgstr "Μόνο όσες δεν έχουν alt"

#: includes/class-tet-alt-admin.php:163
msgid "Also replace automatic (template) alt texts, e.g. with AI ones"
msgstr "Και αντικατάσταση των αυτόματων (από πρότυπο) alt, π.χ. με κείμενα AI"

#: includes/class-tet-alt-admin.php:164
msgid "All images, including alt texts written by people"
msgstr "Όλες οι εικόνες, και όσες έχουν alt γραμμένο από άνθρωπο"

#: includes/class-tet-alt-admin.php:166
msgid "A replaced alt text is kept in the image's data, so it is never lost."
msgstr "Το alt που αντικαθίσταται κρατιέται στα στοιχεία της εικόνας, οπότε δεν χάνεται."

#: includes/class-tet-alt-admin.php:171
msgid "Only show what would be written, save nothing"
msgstr "Μόνο προεπισκόπηση, χωρίς αποθήκευση"

#: includes/class-tet-alt-admin.php:175
msgid "Start"
msgstr "Έναρξη"

#: includes/class-tet-alt-admin.php:176
msgid "Stop"
msgstr "Διακοπή"

#: includes/class-tet-alt-admin.php:180
msgid "Keep this page open while it runs. With AI, every image is one request to your provider."
msgstr "Αφήστε τη σελίδα ανοιχτή όσο τρέχει. Με AI, κάθε εικόνα είναι ένα αίτημα στον πάροχό σας."

#: includes/class-tet-alt-admin.php:186
msgid "Image"
msgstr "Εικόνα"

#: includes/class-tet-alt-admin.php:187 includes/class-tet-alt-media.php:142
msgid "Alt text"
msgstr "Εναλλακτικό κείμενο"

#: includes/class-tet-alt-admin.php:188
msgid "Result"
msgstr "Αποτέλεσμα"

#: includes/class-tet-alt-admin.php:286
msgid "You are not allowed to do this."
msgstr "Δεν έχετε δικαίωμα για αυτή την ενέργεια."

#: includes/class-tet-alt-admin.php:356
msgid "Image Alt Text Autofill writes descriptions (alt text) for the images in the media library, for visitors who use screen readers and for search engines."
msgstr "Το Image Alt Text Autofill γράφει περιγραφές (εναλλακτικό κείμενο, alt) για τις εικόνες της βιβλιοθήκης πολυμέσων, για επισκέπτες που χρησιμοποιούν αναγνώστη οθόνης και για τις μηχανές αναζήτησης."

#: includes/class-tet-alt-admin.php:357
msgid "Without AI, it works only with data already on this site (file names and titles) and sends nothing anywhere."
msgstr "Χωρίς AI χρησιμοποιεί μόνο στοιχεία που υπάρχουν ήδη στον ιστότοπο (ονόματα αρχείων και τίτλους) και δεν στέλνει τίποτα πουθενά."

#: includes/class-tet-alt-admin.php:358
msgid "If AI descriptions are turned on, each image that gets a description is sent, with the site name and the title of the page or product it belongs to, to the AI provider the site owner set up in WordPress (Settings → Connectors). If an image shows people, that may be personal data; the provider's own privacy policy applies to what it receives. Visitors' data is never sent."
msgstr "Αν είναι ενεργές οι περιγραφές με AI, κάθε εικόνα που περιγράφεται στέλνεται, μαζί με το όνομα του ιστότοπου και τον τίτλο της σελίδας ή του προϊόντος όπου ανήκει, στον πάροχο AI που έχει ορίσει ο διαχειριστής στο WordPress (Ρυθμίσεις → Connectors). Αν μια εικόνα δείχνει πρόσωπα, αυτό μπορεί να είναι προσωπικά δεδομένα· για όσα λαμβάνει ο πάροχος ισχύει η δική του πολιτική απορρήτου. Δεδομένα επισκεπτών δεν στέλνονται ποτέ."

#. translators: %s: number of images.
#: includes/class-tet-alt-admin.php:139
msgid "%s image selected in the Media Library."
msgid_plural "%s images selected in the Media Library."
msgstr[0] "Επιλέχθηκε %s εικόνα στη Βιβλιοθήκη πολυμέσων."
msgstr[1] "Επιλέχθηκαν %s εικόνες στη Βιβλιοθήκη πολυμέσων."

#: includes/class-tet-alt-ai.php:90
msgid "No AI provider that can read images is set up."
msgstr "Δεν έχει οριστεί πάροχος AI που διαβάζει εικόνες."

#: includes/class-tet-alt-ai.php:93
msgid "Your user role is not allowed to use AI on this site."
msgstr "Ο ρόλος σας δεν επιτρέπεται να χρησιμοποιεί AI σε αυτόν τον ιστότοπο."

#: includes/class-tet-alt-ai.php:128
msgid "The AI returned no description."
msgstr "Το AI δεν επέστρεψε περιγραφή."

#: includes/class-tet-alt-ai.php:214 includes/class-tet-alt-ai.php:231
msgid "The image file was not found."
msgstr "Το αρχείο της εικόνας δεν βρέθηκε."

#: includes/class-tet-alt-ai.php:219 includes/class-tet-alt-ai.php:223
msgid "This image type cannot be sent to the AI (only JPEG, PNG, GIF and WebP)."
msgstr "Αυτός ο τύπος εικόνας δεν μπορεί να σταλεί στο AI (μόνο JPEG, PNG, GIF και WebP)."

#: includes/class-tet-alt-ai.php:227
msgid "The image is too large to send to the AI."
msgstr "Η εικόνα είναι πολύ μεγάλη για να σταλεί στο AI."

#: includes/class-tet-alt-generator.php:78
msgid "This attachment is not an image."
msgstr "Αυτό το συνημμένο δεν είναι εικόνα."

#: includes/class-tet-alt-generator.php:86
msgid "Your user role is not allowed to use AI on this site, so the template was used."
msgstr "Ο ρόλος σας δεν επιτρέπεται να χρησιμοποιεί AI σε αυτόν τον ιστότοπο, οπότε χρησιμοποιήθηκε το πρότυπο."

#: includes/class-tet-alt-generator.php:102
msgid "Nothing to build an alt text from (the file name says nothing and the image is not attached to a post)."
msgstr "Δεν υπάρχει από πού να βγει alt (το όνομα αρχείου δεν λέει κάτι και η εικόνα δεν ανήκει σε άρθρο)."

#: includes/class-tet-alt-media.php:153 includes/class-tet-alt-media.php:233
msgid "Missing"
msgstr "Λείπει"

#: includes/class-tet-alt-media.php:156 includes/class-tet-alt-media.php:234
msgid "Regenerate"
msgstr "Νέα δημιουργία"

#: includes/class-tet-alt-media.php:156
msgid "Generate"
msgstr "Δημιουργία"

#: includes/class-tet-alt-media.php:171
msgid "Auto"
msgstr "Αυτόματο"

#: includes/class-tet-alt-media.php:178 includes/class-tet-alt-media.php:212
msgid "Generate alt text"
msgstr "Δημιουργία alt"

#: includes/class-tet-alt-media.php:230
msgid "Writing…"
msgstr "Γράφεται…"

#: includes/class-tet-alt-media.php:231
msgid "Done"
msgstr "Έτοιμο"

#: includes/class-tet-alt-media.php:232
msgid "Could not generate the alt text."
msgstr "Δεν ήταν δυνατή η δημιουργία του alt."

#: includes/class-tet-alt-media.php:235
msgid "Replace the current alt text?"
msgstr "Αντικατάσταση του τρέχοντος alt;"

#: includes/class-tet-alt-media.php:258
msgid "You are not allowed to edit this image."
msgstr "Δεν έχετε δικαίωμα επεξεργασίας αυτής της εικόνας."

#: includes/class-tet-alt-settings.php:122
msgid "How alt text is written"
msgstr "Πώς γράφεται το alt"

#: includes/class-tet-alt-settings.php:125
msgid "Source"
msgstr "Πηγή"

#: includes/class-tet-alt-settings.php:128
msgid "Template (file name, titles), no external service"
msgstr "Πρότυπο (όνομα αρχείου, τίτλοι), χωρίς εξωτερική υπηρεσία"

#: includes/class-tet-alt-settings.php:129
msgid "AI: describe the image with the AI provider set up in WordPress"
msgstr "AI: περιγραφή της εικόνας με τον πάροχο AI που έχει οριστεί στο WordPress"

#. translators: %s: list of template tags such as {filename}, {title}.
#: includes/class-tet-alt-settings.php:144
msgid "Tags: %s. A separator next to an empty tag is left out."
msgstr "Ετικέτες: %s. Ένα διαχωριστικό δίπλα σε κενή ετικέτα παραλείπεται."

#. translators: %s: list of template tags such as {filename}, {title}.
#: includes/class-tet-alt-settings.php:146
msgid "{filename} is the file name in words, without sizes or camera names such as IMG_1234. {parent} is the post, page or product the image was uploaded to."
msgstr "Το {filename} είναι το όνομα αρχείου σε λέξεις, χωρίς διαστάσεις ή ονόματα κάμερας όπως IMG_1234. Το {parent} είναι το άρθρο, η σελίδα ή το προϊόν όπου ανέβηκε η εικόνα."

#: includes/class-tet-alt-settings.php:148
msgid "If the template gives nothing, use the title of the post, page or product the image belongs to"
msgstr "Αν το πρότυπο δεν δώσει τίποτα, χρήση του τίτλου του άρθρου, της σελίδας ή του προϊόντος όπου ανήκει η εικόνα"

#: includes/class-tet-alt-settings.php:152
msgid "Maximum length"
msgstr "Μέγιστο μήκος"

#: includes/class-tet-alt-settings.php:155
msgid "characters"
msgstr "χαρακτήρες"

#: includes/class-tet-alt-settings.php:156
msgid "Screen readers handle short alt texts best; 125 is the usual advice."
msgstr "Οι αναγνώστες οθόνης χειρίζονται καλύτερα σύντομα alt· η συνήθης σύσταση είναι 125."

#: includes/class-tet-alt-settings.php:164
msgid "Context"
msgstr "Πλαίσιο"

#: includes/class-tet-alt-settings.php:165
msgid "Send the site name and the title of the post, page or product with the image, for more specific descriptions"
msgstr "Αποστολή του ονόματος του ιστότοπου και του τίτλου του άρθρου, της σελίδας ή του προϊόντος μαζί με την εικόνα, για πιο συγκεκριμένες περιγραφές"

#: includes/class-tet-alt-settings.php:168
msgid "Extra instructions"
msgstr "Επιπλέον οδηγίες"

#: includes/class-tet-alt-settings.php:170
msgid "e.g. We sell handmade ceramics; mention the colour and the glaze."
msgstr "π.χ. Πουλάμε χειροποίητα κεραμικά· να αναφέρεται το χρώμα και το σμάλτο."

#: includes/class-tet-alt-settings.php:171
msgid "Optional. Added to the instructions the AI gets. The alt text is always written in the language of the site."
msgstr "Προαιρετικό. Προστίθεται στις οδηγίες που παίρνει το AI. Το alt γράφεται πάντα στη γλώσσα του ιστότοπου."

#: includes/class-tet-alt-settings.php:175
msgid "Who can use AI"
msgstr "Ποιοι χρησιμοποιούν AI"

#: includes/class-tet-alt-settings.php:182
msgid "Only these roles send images to the AI when they upload or press Generate. For everyone else the template is used. The bulk tool is for administrators only."
msgstr "Μόνο αυτοί οι ρόλοι στέλνουν εικόνες στο AI όταν ανεβάζουν ή πατούν Δημιουργία. Για όλους τους άλλους χρησιμοποιείται το πρότυπο. Το μαζικό εργαλείο είναι μόνο για διαχειριστές."

#: includes/class-tet-alt-settings.php:186
msgid "If AI fails"
msgstr "Αν αποτύχει το AI"

#: includes/class-tet-alt-settings.php:187
msgid "Use the template instead (AI texts can still replace it later)"
msgstr "Χρήση του προτύπου (μπορεί αργότερα να αντικατασταθεί από κείμενο AI)"

#: includes/class-tet-alt-settings.php:191
msgid "When"
msgstr "Πότε"

#: includes/class-tet-alt-settings.php:194
msgid "On upload"
msgstr "Στο ανέβασμα"

#: includes/class-tet-alt-settings.php:195
msgid "Write the alt text of new images when they are uploaded, if it is empty"
msgstr "Συμπλήρωση του alt των νέων εικόνων κατά το ανέβασμα, αν είναι κενό"

#: includes/class-tet-alt-settings.php:198
msgid "On the site"
msgstr "Στον ιστότοπο"

#: includes/class-tet-alt-settings.php:200
msgid "Add a template alt text to images shown without one (nothing is saved, no AI)"
msgstr "Προσθήκη alt από το πρότυπο σε εικόνες που εμφανίζονται χωρίς alt (δεν αποθηκεύεται τίποτα, χωρίς AI)"

#: includes/class-tet-alt-settings.php:201
msgid "Treat an empty alt=\"\" as missing"
msgstr "Το κενό alt=\"\" να θεωρείται ότι λείπει"

#: includes/class-tet-alt-settings.php:202
msgid "alt=\"\" marks a decorative image that screen readers skip. Untick this if your editors set it on purpose."
msgstr "Το alt=\"\" σημαίνει διακοσμητική εικόνα που οι αναγνώστες οθόνης προσπερνούν. Αποεπιλέξτε το αν οι συντάκτες σας το βάζουν σκόπιμα."

#: includes/class-tet-alt-settings.php:214
msgid "Every image is one request to your AI provider, paid with your own API key at the provider's prices. This plugin adds no charge of its own and cannot see or limit what the provider bills. Check the provider's pricing and set a spending limit in your account there, especially before a bulk run on a large library."
msgstr "Κάθε εικόνα είναι ένα αίτημα στον πάροχο AI, που χρεώνεται στο δικό σας API key με τις τιμές του παρόχου. Το πρόσθετο δεν έχει δική του χρέωση και δεν μπορεί να δει ή να περιορίσει όσα χρεώνει ο πάροχος. Ελέγξτε τον τιμοκατάλογο του παρόχου και ορίστε όριο δαπάνης στον λογαριασμό σας εκεί, ειδικά πριν από μαζική εκτέλεση σε μεγάλη βιβλιοθήκη."

#: includes/class-tet-alt-settings.php:239
msgid "An AI provider that can read images is set up."
msgstr "Έχει οριστεί πάροχος AI που διαβάζει εικόνες."

#: includes/class-tet-alt-settings.php:240
msgid "With AI, each image is sent to that provider to be described."
msgstr "Με AI, κάθε εικόνα στέλνεται σε αυτόν τον πάροχο για να περιγραφεί."

#: includes/class-tet-alt-settings.php:244
msgid "AI needs WordPress 7.0 or newer."
msgstr "Το AI χρειάζεται WordPress 7.0 ή νεότερο."

#: includes/class-tet-alt-settings.php:245
msgid "AI is turned off on this site (WP_AI_SUPPORT or the wp_supports_ai filter)."
msgstr "Το AI είναι απενεργοποιημένο σε αυτόν τον ιστότοπο (WP_AI_SUPPORT ή φίλτρο wp_supports_ai)."

#: includes/class-tet-alt-settings.php:246
msgid "No AI provider that can read images is set up yet."
msgstr "Δεν έχει οριστεί ακόμη πάροχος AI που διαβάζει εικόνες."

#: includes/class-tet-alt-settings.php:250
msgid "Set one up in Settings → Connectors"
msgstr "Ορίστε έναν στις Ρυθμίσεις → Connectors"
